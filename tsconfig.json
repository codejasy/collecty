{
  "compilerOptions": {
    "rootDir": "./src",
    "types": ["jest"],
    "moduleResolution": "node",
    "target": "es2015",
    "lib": ["es2016", "dom"],
    "declaration": true,
    "declarationDir": "./dist/types",
    "strict": true,
    "outDir": "./dist/mjs",
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "**/__tests__/*"
  ],
}